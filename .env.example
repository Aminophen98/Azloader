# Path where credentials/token/DB are stored (default: /data)
DATA_DIR=/data

# Optional: proxy for yt-dlp downloads
# Examples:
#   PROXY=socks5://127.0.0.1:1080
#   PROXY=http://user:pass@proxy-host:8080
PROXY=

# Set to "true" to skip SSL certificate verification (needed with MITM proxies)
NO_CHECK_CERT=false
